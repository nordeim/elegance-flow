// EleganceFlow — Prisma schema (SQLite)
// Domain model cloned from the reference app
// (colossal-elevate-service-flow.base44.app): login users (the studio
// team) and the contact-form INQUIRIES the public landing receives.
//
// Session 199 (the domain transformation): the CRM domain models
// (Account/Contact/Lead/Event/Activity/Opportunity/SavedReport/Setting)
// retired with the CRM surfaces; the auth surface (scrypt + HMAC cookie
// sessions, the email-verification funnel, the hashed reset funnel, the
// tokenVersion revocation dimension) carries over verbatim on User.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#2563eb")
  photoUrl     String?
  role         String   @default("user") // user | admin
  // Session-21 (S21-P5): the email-verification funnel. A NULL
  // verificationExpiresAt means "no verification pending" — the seeded
  // demo users and every pre-session-21 account pass straight through
  // login. The code itself is stored HASHED (scrypt, auth.ts's format);
  // the plaintext rides only the server console log.
  verificationCodeHash   String?
  verificationAttempts   Int      @default(0)
  verificationExpiresAt  DateTime?
  // Session-163 (the digma S67-A port): the revocation dimension. Every
  // session token embeds the row's tokenVersion at mint time; a password
  // reset increments it and every previously minted cookie dies at the
  // getSessionUser comparison (a stolen session no longer outlives the
  // reset performed specifically to kill it).
  tokenVersion Int @default(0)
  // Session-163 (the digma S46/S64 port): the password-reset funnel. A
  // NULL resetToken means "no reset pending"; the token is a 32-byte
  // crypto-random hex consumed ATOMICALLY and SINGLE-USE (the conditional
  // updateMany carries token + live expiry in its WHERE — a racing replay
  // lands count 0 and answers the invalid-token 400). 60-minute TTL.
  // Session-164 (the skill §12 hashed-at-rest compliance): the column
  // stores hashResetToken(token) — the SHA-256 hex of the raw token, the
  // same hashed-storage posture as verificationCodeHash; the raw token
  // lives only in the delivery URL, so a DB read compromise never mints
  // live reset links.
  resetToken           String?
  resetTokenExpiresAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// The contact-form inquiry — the landing's "SEND INQUIRY" round trip.
// The reference app collects the form and answers with a toast only
// (verified live); OURS persists every inquiry (the superset) and the
// authenticated /dashboard inbox reads/moves/deletes them through this
// model. service carries the form select's exact vocabulary (one of the
// five options — validated at the Zod seam, src/lib/schemas.ts).
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  service   String // "Creative Direction" | "Design & Web" | "Photography" | "Brand Strategy" | "Other / Not Sure"
  message   String
  status    String   @default("new") // new | read | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
